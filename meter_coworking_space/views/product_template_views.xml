<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="coworking_space_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.coworking.space</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="space_ok"/>
                    <label for="space_ok"/>
                </span>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="floor_id" invisible="not space_ok"/>
            </xpath>
        </field>
    </record>

    <record id="coworking_space_product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search.inherit.coworking.space</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_sell" position="after">
                <filter string="Coworking Spaces" name="filter_is_space" domain="[('space_ok', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
