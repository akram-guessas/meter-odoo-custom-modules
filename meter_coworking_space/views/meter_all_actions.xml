<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="floor_action" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">mtr_coworking.floor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first floor.</p>
        </field>
    </record>

    <record id="mtr_order_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="coworking_space_order_view_search"/>
        <field name="context">{'search_default_from_cw_space': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a quotation to book a space.</p>
            <p>Add a coworking space, set the booking start and end, then confirm the order.</p>
        </field>
    </record>

    <record id="coworking_space_template_action" model="ir.actions.act_window">
        <field name="name">Spaces</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'default_space_ok': True,
            'default_type': 'service',
            'default_sale_ok': True,
            'default_purchase_ok': False,
            'search_default_filter_is_space': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first coworking space.</p>
        </field>
    </record>
</odoo>
