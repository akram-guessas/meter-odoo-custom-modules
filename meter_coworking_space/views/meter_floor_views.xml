<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_floor_form" model="ir.ui.view">
        <field name="name">mtr_coworking.floor.form</field>
        <field name="model">mtr_coworking.floor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="floor_capacity"/>
                        </group>
                        <group>
                            <field name="num_spaces"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description"/>
                    <field name="space_ids">
                        <list>
                            <field name="name"/>
                            <field name="list_price"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_floor_list" model="ir.ui.view">
        <field name="name">mtr_coworking.floor.list</field>
        <field name="model">mtr_coworking.floor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="floor_capacity"/>
                <field name="num_spaces"/>
            </list>
        </field>
    </record>
</odoo>
